# Model files. Relative paths are resolved from the repository root.
S2S_LLM_MODEL=models/llm/Qwen3.5-4B-UD-Q4_K_XL.gguf
S2S_TTS_TALKER=models/qwen3-tts/qwen-talker-1.7b-customvoice-Q8_0.gguf
S2S_TTS_CODEC=models/qwen3-tts/qwen-tokenizer-12hz-Q8_0.gguf
S2S_SMART_TURN_MODEL=models/smart-turn-v3/smart-turn-v3.2-cpu.onnx

# Inference settings.
S2S_STT_DEVICE=cuda
S2S_TTS_SPEAKER=aiden
S2S_LLM_GPU_LAYERS=99
S2S_LLM_CONTEXT_SIZE=8192

# Local service endpoints.
S2S_LLM_HOST=127.0.0.1
S2S_LLM_PORT=8080
S2S_PIPELINE_HOST=127.0.0.1
S2S_PIPELINE_PORT=8765
S2S_DEMO_HOST=127.0.0.1
S2S_DEMO_PORT=7860
